<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.calendar.CalendarFragment">

    <LinearLayout
        android:id="@+id/current_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_space2"
        android:background="@drawable/rounded_ripple"
        android:paddingVertical="@dimen/small_space"
        android:paddingStart="@dimen/small_space"
        app:layout_constraintBottom_toTopOf="@id/recycler_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MdcTypographyStyles.DisplaySmall"
            tools:text="Апрель" />

        <TextView
            android:id="@+id/year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/small_space"
            android:textAppearance="@style/TextAppearance.MdcTypographyStyles.DisplaySmall"
            tools:text="2025" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/baseline_arrow_drop_down_24"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/go_to_current_day_card"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/small_space"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintBottom_toBottomOf="@+id/current_date"
        app:layout_constraintStart_toEndOf="@id/current_date"
        app:layout_constraintTop_toTopOf="@id/current_date"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.ExtraSmall">

        <TextView
            android:id="@+id/go_to_current_day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.MdcTypographyStyles.HeadlineSmall"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="26" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/weather_layout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/medium_icon_size"
        android:layout_marginEnd="@dimen/medium_space2"
        android:background="@drawable/rounded_ripple"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/extra_small_space"
        android:radius="10dp"
        app:layout_constraintBottom_toTopOf="@id/recycler_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/weather_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MdcTypographyStyles.HeadlineSmall"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/current_temperature"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Вт, 3 июн" />

        <TextView
            android:id="@+id/current_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MdcTypographyStyles.HeadlineSmall"
            android:visibility="gone"
            tools:text="19°С" />

        <ProgressBar
            android:id="@+id/progress_indicator"
            android:layout_width="@dimen/medium_icon_size"
            android:layout_height="@dimen/medium_icon_size"
            android:visibility="visible" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="@dimen/zero"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/extra_small_space"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/current_date"
        tools:listitem="@layout/recycler_view_calendar_item" />

    <ScrollView
        android:layout_width="@dimen/zero"
        android:layout_height="@dimen/zero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recycler_view">

        <com.nc.calendar.presentation.calendar.DayTimelineView
            android:id="@+id/dayTimelineView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/medium_space2" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>